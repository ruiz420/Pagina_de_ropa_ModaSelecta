# --- Base de datos (PostgreSQL local o Supabase; ver docs/base-de-datos.md) ---
# En tu equipo con Supabase usa la cadena "Session pooler" en las dos variables.
# En hosting en la nube (Vercel): DATABASE_URL = "Transaction pooler" (puerto 6543,
# termina en ?pgbouncer=true) y DIRECT_URL = "Session pooler" (puerto 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ropa_b2b?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ropa_b2b?schema=public"

# --- Sesiones y administrador ---
NEXTAUTH_URL="http://localhost:3000"

# Secreto de sesion: obligatorio en produccion, minimo 32 caracteres, unico y privado.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_SECRET=""

# Administrador inicial (npm run db:seed) y cambio de clave (npm run admin:password).
# La contrasena debe tener al menos 12 caracteres. No uses la misma en otros sitios.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Fotos de productos: Supabase Storage (obligatorio al publicar en la nube) ---
# Crea un bucket PUBLICO llamado "productos" (Storage > New bucket).
# SUPABASE_SERVICE_ROLE_KEY es secreta: solo en el servidor, nunca con NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="productos"

# --- Tienda ---
# Numero de WhatsApp con indicativo de pais y sin signos, ej. 573001234567.
NEXT_PUBLIC_WHATSAPP_NUMBER="57XXXXXXXXXX"
